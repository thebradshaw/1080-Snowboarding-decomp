+
+    void VIRenderer::getScreenArea(float windowWidth, float windowHeight, float &x, float &y, float &width, float &height) {
+        x = 0.0f;
+        y = 0.0f;
+        width = windowWidth;
+        height = windowHeight;
+        if (!tvBackground.active.load(std::memory_order_acquire) || (windowWidth <= 0.0f) || (windowHeight <= 0.0f)) {
+            return;
+        }
+
+        const std::scoped_lock lock(tvBackground.mutex);
+        if ((tvBackground.width == 0) || (tvBackground.height == 0)) {
+            return;
+        }
+
+        float imageX, imageY, imageWidth, imageHeight;
+        fitBackground(windowWidth, windowHeight, float(tvBackground.width) / float(tvBackground.height), tvBackground.screen, imageX, imageY, imageWidth, imageHeight);
+        x = imageX + tvBackground.screen[0] * imageWidth;
+        y = imageY + tvBackground.screen[1] * imageHeight;
+        width = std::max((tvBackground.screen[2] - tvBackground.screen[0]) * imageWidth, 1.0f);
+        height = std::max((tvBackground.screen[3] - tvBackground.screen[1]) * imageHeight, 1.0f);
+    }
+
+    bool VIRenderer::prepareBackground(RenderDevice *device, RenderCommandList *commandList) {
+        if (!tvBackground.active.load(std::memory_order_acquire)) {
+            return false;
+        }
+
+        const std::scoped_lock lock(tvBackground.mutex);
+        if ((tvBackground.width == 0) || (tvBackground.height == 0)) {
+            return false;
+        }
+
+        if ((backgroundTexture == nullptr) || (backgroundVersion != tvBackground.version)) {
+            const uint32_t width = tvBackground.width;
+            const uint32_t height = tvBackground.height;
+            const uint32_t rowPitch = width * 4;
+            const uint32_t alignedRowPitch = (rowPitch + 255) & ~255U;
+            backgroundTexture = device->createTexture(RenderTextureDesc::Texture2D(width, height, 1, RenderFormat::R8G8B8A8_UNORM));
+            backgroundUpload = device->createBuffer(RenderBufferDesc::UploadBuffer(alignedRowPitch * height));
+            uint8_t *dstData = reinterpret_cast<uint8_t *>(backgroundUpload->map());
+            for (uint32_t row = 0; row < height; row++) {
+                memcpy(dstData + size_t(row) * alignedRowPitch, tvBackground.pixels.data() + size_t(row) * rowPitch, rowPitch);
+            }
+
+            backgroundUpload->unmap();
+            commandList->barriers(RenderBarrierStage::COPY, RenderTextureBarrier(backgroundTexture.get(), RenderTextureLayout::COPY_DEST));
+            commandList->copyTextureRegion(RenderTextureCopyLocation::Subresource(backgroundTexture.get()), RenderTextureCopyLocation::PlacedFootprint(backgroundUpload.get(), RenderFormat::R8G8B8A8_UNORM, width, height, 1, alignedRowPitch / 4));
+            commandList->barriers(RenderBarrierStage::GRAPHICS, RenderTextureBarrier(backgroundTexture.get(), RenderTextureLayout::SHADER_READ));
+            backgroundWidth = width;
+            backgroundHeight = height;
+            backgroundVersion = tvBackground.version;
+            memcpy(backgroundScreen, tvBackground.screen, sizeof(backgroundScreen));
+
+            // The image is now on the GPU.
+            tvBackground.pixels.clear();
+            tvBackground.pixels.shrink_to_fit();
+        }
+
+        return true;
+    }
+
+    void VIRenderer::renderBackground(RenderDevice *device, RenderCommandList *commandList, const RenderSwapChain *swapChain, const ShaderLibrary *shaderLibrary) {
+        if ((backgroundTexture == nullptr) || (backgroundWidth == 0) || (backgroundHeight == 0)) {
+            return;
+        }
+
+        const ShaderRecord *shader = &shaderLibrary->videoInterfaceLinear;
+        const RenderSampler *sampler = shaderLibrary->samplerLibrary.linear.clampClamp.get();
+        if (backgroundDescriptorSet == nullptr) {
+            backgroundDescriptorSet = std::make_unique<VideoInterfaceDescriptorSet>(sampler, device);
+        }
+
+        backgroundDescriptorSet->setTexture(backgroundDescriptorSet->gInput, backgroundTexture.get(), RenderTextureLayout::SHADER_READ);
+
+        const float windowWidth = float(swapChain->getWidth());
+        const float windowHeight = float(swapChain->getHeight());
+        float x, y, width, height;
+        fitBackground(windowWidth, windowHeight, float(backgroundWidth) / float(backgroundHeight), backgroundScreen, x, y, width, height);
+        commandList->setViewports(RenderViewport(x, y, width, height));
+        commandList->setScissors(RenderRect(0, 0, int32_t(windowWidth), int32_t(windowHeight)));
+
+        interop::VideoInterfaceCB pushConstants;
+        pushConstants.videoResolution = { float(backgroundWidth), float(backgroundHeight) };
+        pushConstants.textureResolution = { float(backgroundWidth), float(backgroundHeight) };
+        pushConstants.gamma = 1.0f;
+        pushConstants.crtMode = 0.0f;
+        pushConstants.crtLines = 1.0f;
+        commandList->setPipeline(shader->pipeline.get());
+        commandList->setGraphicsPipelineLayout(shader->pipelineLayout.get());
+        commandList->setGraphicsDescriptorSet(backgroundDescriptorSet->get(), 0);
+        commandList->setGraphicsPushConstants(0, &pushConstants);
+        commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        commandList->drawInstanced(3, 1, 0, 0);
+    }
+};
+
+// Sets the TV background: RGBA8 pixels (copied), and the TV screen as fractions of the image
+// (left, top, right, bottom). Pass null pixels to turn it off.
+extern "C" void rt64_set_tv_background(const uint8_t *rgba, uint32_t width, uint32_t height, float left, float top, float right, float bottom) {
+    RT64::TVBackground &tv = RT64::tvBackground;
+    const std::scoped_lock lock(tv.mutex);
+    if ((rgba == nullptr) || (width == 0) || (height == 0)) {
+        tv.active.store(false, std::memory_order_release);
+        tv.width = 0;
+        tv.height = 0;
+        tv.pixels.clear();
+        tv.pixels.shrink_to_fit();
+        tv.version++;
+        return;
+    }
+
+    tv.pixels.assign(rgba, rgba + size_t(width) * height * 4);
+    tv.width = width;
+    tv.height = height;
+    tv.screen[0] = left;
+    tv.screen[1] = top;
+    tv.screen[2] = right;
+    tv.screen[3] = bottom;
+    tv.version++;
+    tv.active.store(true, std::memory_order_release);
+}
+
+extern "C" void rt64_set_crt_filter(uint32_t mode) {
+    RT64::crtFilterMode.store(mode, std::memory_order_relaxed);
+}
